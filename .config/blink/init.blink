option ClientOutput = "../../network/Client.luau"
option ServerOutput = "../../network/Server.luau"
option Casing = Pascal

import "./Types.blink" as Types

event ClientLoaded {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true
}

event Notification {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        Text: string,
        Duration: u8?,
        Type: Types.NotificationType
    }
}

event Setup_Tool {
	From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: Instance(Tool)
}

event Setup_Sell_Prompt {
	From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
		Brainrot_Name: string,
		Primary_Mutation: string?,
		Brainrot_Model: Instance(Model),
		Sell_Price: f64
	}
}

scope VFX { 
	event Buy {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
    }

	event Block_Spawn {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}

	event Block_Hit {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}

	event Brainrot_Cycle {
		From: Server,
    	Type: Reliable,
    	Call: SingleSync,
		Poll: true,
    	Data: struct {
			Block: string,
			Mutation_Luck: u8,
        	Owner: Types.Id,
        	Brainrot_CF: CFrame,
			Spin_VFX_CF: CFrame,
        	Rolled_Brainrot: struct {
            	Name: string,
            	Primary_Mutation: string?,
				Secondary_Mutations: string[],
				Weight: Types.Weight
        	}
    	}
	}

	event Swing {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}

	event Bounce_Brainrot {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}

	event Rebirth {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}

	event Robux_Purchase {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}
}

scope Requests {
	event Buy_Pickaxe {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
    }

	event Equip_Pickaxe {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
    }

	event Buy_Block {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
    }

	event Buy_Upgrade {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
	}

	event Skip_Block {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true
	}

	event Swing {
		From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
		Data: Types.Id?
	}

  	event Collect {
       From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
       Data: Types.Id
    }

	event Pickup {
       From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
       Data: Types.Id
    }

	event Place {
       From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
       Data: Instance(Model)  
    }

	event Equip_Best_Brainrots {
	   From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
	}

	event Sell_Brainrot {
       From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
       Data: Types.Id
    }

	event Sell_All {
       From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true
	}

	event Sell_Brainrot_Item_Group {
	   From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
       Data: struct {
		    Name: string,
			Primary_Mutation: string?,
			Secondary_Mutations: string[]
		}
	}

	event Gift {
	   From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
	   Data: Types.Id
	}

	event Rebirth {
	   From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
	}

	event Claim_Group_Reward {
	   From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
	}

	event Claim_Daily_Reward {
	   From: Client,
       Type: Reliable,
       Call: SingleSync,
	   Poll: true,
	   Data: u8
	}
}

scope DataChanged {
	event Cash {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Cash
    }

	event Rebirth {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Rebirth
    }

	event Pickaxe {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string
    }

  	event Owned_Pickaxes {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[]
    }

	event Opens {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Opens
    }

    event Gamepasses {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[]
    }

	event Stock {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: map { [string]: f64 }
    }

	event Last_Restock {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: f64
    }

	event Upgrades {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: map { [string]: u8 }
    }

	event Plot_Assigned { 
		From: Server,
		Type: Reliable,
		Call: SingleSync,
		Poll: false,
		Data: Instance(Model)
	}

	event Brainrot_Inventory {
		From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Brainrot_Item[] 
	}

	event Index {
		From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: map { [string]: string[] }
	}

	event Active_Events {
		From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: map { 
			[string]: struct {
				Start_Time: f64,
				End_Time: f64,
				Luck_Multiplier: u8
			}
		}
	}

	event Last_Daily_Reward_Claim {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: f64
    }

	event Claimed_Daily_Rewards {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[] 
    }

	event Plot_Income_Per_Sec {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: f64
    }
}
