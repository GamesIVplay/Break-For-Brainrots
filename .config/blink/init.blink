option ClientOutput = "../../network/Client.luau"
option ServerOutput = "../../network/Server.luau"
option Casing = Pascal

import "./Types.blink" as Types

event ClientLoaded {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true
}

scope DataChanged {
	event Cash {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Cash
    }

	event Pickaxe {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string
    }

  	event Owned_Pickaxes {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[]
    }

    event Gamepasses {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[]
    }


	event Plot_Assigned { 
		From: Server,
		Type: Reliable,
		Call: SingleSync,
		Poll: false,
		Data: Instance(Model)
	}
}
