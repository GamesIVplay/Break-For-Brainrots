option ClientOutput = "../../network/Client.luau"
option ServerOutput = "../../network/Server.luau"
option Casing = Pascal

import "./Types.blink" as Types

event ClientLoaded {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
	Poll: true
}

event Notification {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
	Poll: true,
    Data: struct {
        Text: string,
        Duration: u8?,
        Type: Types.NotificationType
    }
}

scope VFX { 
	event Buy {
        From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
    }

	event Block_Spawn {
		From: Server,
        Type: Reliable,
        Call: SingleSync,
		Poll: true,
        Data: Instance(Model) 
	}
}

scope Requests {
	event Buy_Pickaxe {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
    }

	event Equip_Pickaxe {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
    }

	event Buy_Block {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
    }

	event Buy_Upgrade {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string 
	}

	event Skip_Block {
        From: Client,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true
	}
}

scope DataChanged {
	event Cash {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Cash
    }

	event Rebirth {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Rebirth
    }

	event Pickaxe {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string
    }

  	event Owned_Pickaxes {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[]
    }

	event Opens {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: Types.Opens
    }

    event Gamepasses {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: string[]
    }

	event Stock {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: map { [string]: f64 }
    }

	event Last_Restock {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: f64
    }

	event Upgrades {
        From: Server,
        Type: Reliable,
        Call: SingleSync, 
		Poll: true,
        Data: map { [string]: u8 }
    }

	event Plot_Assigned { 
		From: Server,
		Type: Reliable,
		Call: SingleSync,
		Poll: false,
		Data: Instance(Model)
	}
}
